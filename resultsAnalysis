import json
 
with open("data/datasets/demo/my_results.sarif") as f:
    data = json.load(f)
 
run = data["runs"][0]
results = run["results"]
artifacts = run["artifacts"]
 
for artifact in artifacts:
    file_name = artifact["location"]["uri"]
    found_any = False
 
    # look for errors that belong to this file
    for r in results:
        place = r["locations"][0]["physicalLocation"]
        if place["artifactLocation"]["uri"] == file_name:
            if found_any == False:
                print(file_name, "- errors found:")
                found_any = True
            line = place["region"]["startLine"]
            print("   line", line, "-", r["message"]["text"])
 
